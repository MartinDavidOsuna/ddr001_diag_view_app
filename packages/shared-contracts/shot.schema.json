{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddr001/evidence",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "sample_id", "type", "required", "sha256", "captured_at"],
  "properties": {
    "evidence_id": { "type": "string" },
    "sample_id": { "type": "string" },
    "point_id": { "type": ["string", "null"] },
    "type": { "type": "string", "enum": ["START", "INTERMEDIATE", "FINAL", "EXTRA"] },
    "required": { "type": "boolean" },
    "volume_ref_l": { "type": ["number", "null"] },
    "pulse_count": { "type": ["integer", "null"] },
    "sha256": { "type": "string", "minLength": 32 },
    "local_path": { "type": ["string", "null"] },
    "server_storage_key": { "type": ["string", "null"] },
    "captured_at": { "type": "string", "format": "date-time" }
  }
}
