{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddr001/point",
  "title": "Point",
  "type": "object",
  "additionalProperties": false,
  "required": ["point_id", "sample_id", "type", "captured_at"],
  "properties": {
    "point_id": { "type": "string" },
    "sample_id": { "type": "string" },
    "type": { "type": "string", "enum": ["START", "INTERMEDIATE", "FINAL", "MANUAL_DIAGNOSTIC"] },
    "pulse_count": { "type": ["integer", "null"], "minimum": 0 },
    "v_ref_l": { "type": ["number", "null"], "minimum": 0 },
    "reading_l": { "type": ["number", "null"] },
    "v_ind_l": { "type": ["number", "null"] },
    "diagnostic_error_pct": { "type": ["number", "null"] },
    "needle_l": { "type": ["number", "null"] },
    "captured_at": { "type": "string", "format": "date-time" }
  }
}
