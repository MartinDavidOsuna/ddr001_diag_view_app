diff --git a/src/security/jwt.ts b/src/security/jwt.ts
index c8482b3..98c195e 100644
--- a/src/security/jwt.ts
+++ b/src/security/jwt.ts
@@ -71,14 +71,27 @@ export function issueAdminTokens(data: Omit<AdminClaims, 'tokenId' | 'type'>) {
 }
 export function verifyRefresh(token: string, kind: 'field' | 'admin'): AuthPrincipal {
   const e = getEnv();
-  const value = jwt.verify(
-    token,
-    kind === 'field' ? e.FIELD_REFRESH_SECRET : e.ADMIN_REFRESH_SECRET,
-    // La vigencia de campo la controla el estado revocable de la sesión en
-    // SQL. El JWT conserva firma e identidad, pero no cierra por tiempo una
-    // sesión de captura. Los tokens administrativos sí conservan expiración.
-    kind === 'field' ? { ignoreExpiration: true } : undefined,
-  ) as FieldClaims | AdminClaims;
+  let value: FieldClaims | AdminClaims;
+  try {
+    value = jwt.verify(
+      token,
+      kind === 'field' ? e.FIELD_REFRESH_SECRET : e.ADMIN_REFRESH_SECRET,
+      // Field lifetime remains controlled by revocable SQL session state.
+      // Only admin refresh credentials expire by JWT time.
+      kind === 'field' ? { ignoreExpiration: true } : undefined,
+    ) as FieldClaims | AdminClaims;
+  } catch (error) {
+    if (error instanceof jwt.JsonWebTokenError) {
+      throw new AppError(
+        401,
+        'Invalid refresh token',
+        'La credencial de renovación ya no es válida. Inicia sesión nuevamente.',
+        [],
+        'INVALID_REFRESH_TOKEN',
+      );
+    }
+    throw error;
+  }
   if (value.type !== kind) throw new AppError(401, 'Invalid token', 'Token audience is invalid.');
   return toPrincipal(value);
 }
