diff --git a/tests/unit/refresh-invalid-token.test.ts b/tests/unit/refresh-invalid-token.test.ts
new file mode 100644
index 0000000..f69340d
--- /dev/null
+++ b/tests/unit/refresh-invalid-token.test.ts
@@ -0,0 +1,45 @@
+import jwt from 'jsonwebtoken';
+import request from 'supertest';
+import { describe, expect, it, vi } from 'vitest';
+
+vi.mock('../../src/db/pool.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../src/db/pool.js')>();
+  return {
+    ...actual,
+    db: vi.fn(() => {
+      throw new Error('Invalid JWT must not query SQL');
+    }),
+  };
+});
+const { createApp } = await import('../../src/app.js');
+const { db } = await import('../../src/db/pool.js');
+
+const claims = {
+  type: 'field',
+  userId: '00000000-0000-4000-8000-000000000001',
+  workSessionId: '00000000-0000-4000-8000-000000000002',
+  deviceId: '00000000-0000-4000-8000-000000000003',
+  tokenId: '00000000-0000-4000-8000-000000000004',
+};
+
+describe('refresh invalid credential HTTP contract', () => {
+  for (const [name, token] of [
+    ['malformed', 'not-a-jwt'],
+    ['different signing key', jwt.sign(claims, 'x'.repeat(32))],
+    [
+      'not yet valid',
+      jwt.sign({ ...claims, nbf: Math.floor(Date.now() / 1000) + 3600 }, 'r'.repeat(32)),
+    ],
+  ]) {
+    it(`${name} returns 401 before touching SQL`, async () => {
+      vi.mocked(db).mockClear();
+      const response = await request(createApp())
+        .post('/api/v1/field-sessions/refresh')
+        .send({ refreshToken: token });
+      expect(response.status).toBe(401);
+      expect(response.body).toMatchObject({ code: 'INVALID_REFRESH_TOKEN' });
+      expect(db).not.toHaveBeenCalled();
+      expect(JSON.stringify(response.body)).not.toContain(token);
+    });
+  }
+});
